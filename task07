#include<stdio.h>
int main(){
    float marks[5];
    float total=0, average, highest=0, lowest=0;
    printf("enter themarks of 5 students");
    for (int i=0; i<5;i++)
    {
       printf("students %d",i+1);
       scanf("%f",&marks[i]);
    }
    highest=marks[0];
    lowest=marks[0];
    total=marks[0];
    for ( int i=1;i<5; i++)
    {
       total=total+marks[i];
       if (marks[i]>highest)
       {
        highest=marks[i];
       }
       if (marks[i]<lowest)
       {
       lowest=marks[i];
       }
    }
    average=total/5;
    printf("total marks %.2f",total);
    printf("average marks %.2f",average);
    printf("highest marks %.2f",highest);
    printf("lowest marks %.2f",lowest);
}
       

        

    
    
    
