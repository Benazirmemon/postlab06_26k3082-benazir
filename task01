#include<stdio.h>
int main(){
    int amount, balance=50000, numofwithdrawals=0;
    printf("enter the withdrawal amount");
    scanf("%d",&amount);
    while (amount > 0)
    {
      balance =balance-amount;
      numofwithdrawals++;
      printf("enter the withdrawal amount is");
      scanf("%d",&amount);
    }
    printf("the remaining balance is %d",balance);
    printf("the num of withdrawals is %d",numofwithdrawals);
}


    
