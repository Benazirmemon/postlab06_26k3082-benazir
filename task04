#include<stdio.h>
int main(){
    int price, choice;
    float total=0, discount, finalamount;
    printf("enter the price of an item");
    scanf("%d",&price);
    printf("do you want to add another item (1=yes, 0=no)");
    scanf("%d",&choice);
    while (choice==1){
        printf("enter the price of an item");
        scanf("%d",&price);
        total=total+price;
        printf("do you want to add another item (1=yes, 0=no)");
        scanf("%d",&choice);
    }
    if (total >10000)
    {
       discount=total*0.10;
    }
   
finalamount =total-discount;
printf("the total price is %.2f",total);
printf("the discount is %.2f",discount);
printf("the final price is %.2f",finalamount);
}


    


        
   
    
  
